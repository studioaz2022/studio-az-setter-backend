    "profile": {
      "description": "Studio AZ Tattoo is a modern tattoo studio located in the heart of Minneapolis, right beneath Studio AZ Barbershop. We specialize in clean linework, custom designs, and walk-in flash — all delivered in a professional, welcoming space. Whether it’s your first tattoo or your tenth, we make sure you feel heard, respected, and hyped for the final result. Our team of talented artists each brings a unique style, with bios and portfolios available so you always know who you’re booking with. No pressure, no attitude — just quality ink and good vibes. We’re proud to serve the Latino community and beyond with bilingual artists, a laid-back atmosphere, and tattoos that speak louder than words. Book online or stop by. We’re here to help you wear you."
    },
    "serviceItems": [
      {
        "structuredServiceItem": {
          "serviceTypeId": "job_type_id:abstract_tattoos",
          "description": "Abstract tattoos in Minneapolis at Studio AZ. One-of-a-kind designs blending artistic experimentation with precise execution — geometric patterns, flowing linework, surreal compositions. Every piece original, never repeated. Free consultation. North Loop."
        }
      },
      {
        "structuredServiceItem": {
          "serviceTypeId": "job_type_id:fine_detail_tattoos",
          "description": "Fine line tattoos in Minneapolis — delicate, precise linework that holds up over time. Specializing in floral designs, geometric patterns, script, and minimalist pieces. Every design custom-made during a free consultation. North Loop. Appointment only."
        }
      },
      {
        "structuredServiceItem": {
          "serviceTypeId": "job_type_id:tattoo_design",
          "description": "Custom tattoo design in Minneapolis. Every tattoo at Studio AZ is designed from scratch — no flash, no templates. Free consultation, original artwork based on your vision, design approval before your appointment day. Available in English and Spanish."
        }
      },
      {
        "structuredServiceItem": {
          "serviceTypeId": "job_type_id:tattoo",
          "description": "Custom tattoos in Minneapolis. 100% original designs — no flash, no templates. Specialties: fine line, realism, black & grey, color, custom work. Spanish-speaking artists with full English consultation support. North Loop. Free consultation. Appointment only."
        }
      },
      {
        "freeFormServiceItem": {
          "category": "categories/gcid:tattoo_shop",
          "label": {
            "displayName": "Realism Tattoos",
            "description": "Realism tattoos in Minneapolis at Studio AZ. Photorealistic portraits, religious imagery, animals, and memorial pieces with lifelike detail and smooth shading. Color and black & grey realism. Free consultation, custom-designed for you. North Loop."
          }
        }
      },
      {
        "freeFormServiceItem": {
          "category": "categories/gcid:tattoo_shop",
          "label": {
            "displayName": "Black and Grey Tattoos",
            "description": "Black and grey tattoos in Minneapolis. Tonal depth and smooth shading create dimension without color. Religious imagery, Polynesian patterns, florals, portraits, and large-scale sleeve work. Free consultation, custom-designed every time. North Loop."
          }
        }
      }
    ]
